{
  "name": "pi-genshin-companion",
  "version": "0.1.0",
  "description": "Pi 像素角色同伴：启动页、画作选择、语录轮播与角色人格",
  "keywords": ["pi-package", "pi-extension"],
  "type": "module",
  "files": ["index.ts", "characters", "catalog", "startup", "picker", "quotes", "preamble", "store.ts", "README.md"],
  "pi": { "extensions": ["./index.ts"] },
  "exports": { ".": "./index.ts" },
  "scripts": { "typecheck": "tsc --noEmit", "test": "vitest run", "test:coverage": "vitest run --coverage" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
