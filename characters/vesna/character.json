{
  "version": 1,
  "id": "vesna",
  "name": "薇斯纳",
  "englishName": "Vesna",
  "element": "anemo",
  "defaultArtwork": "front-blush",
  "artworks": ["tilted.json", "front-blush.json"],
  "quotes": [
    { "category": "薇斯纳的烦恼", "text": "别听达妮卡胡说，我的开车技术真不差，那叫人车合一。等我的开车禁令解除后，就载你去兜风吧！" },
    { "category": "讨厌的食物", "text": "嘿嘿！烦人的蔬菜统统挑到达妮卡的盘子里喽！呜——又被夹回来了..." },
    { "category": "收到赠礼·其一", "text": "那么，我不客气啦，把美味统统收藏进肚子里。" },
    { "category": "收到赠礼·其二", "text": "嗯嗯...烹饪的巧思吗...嗯嗯...我再尝一口。" },
    { "category": "收到赠礼·其三", "text": "我吃饱啦谢谢！这些我打包给达妮卡吃~" },
    { "category": "突破的感受·起", "text": "新兵训练第一课：风雪压不弯的脊背，才有资格护卫在陛下左右。" },
    { "category": "突破的感受·承", "text": "新兵训练第二课：握剑的手不许抖。" },
    { "category": "突破的感受·转", "text": "新兵训练第三课：敌人面前不许哭。" },
    { "category": "突破的感受·合", "text": "而我亲爱的朋友，你教给了我另一课：留一丝柔软，去拥抱风雪后，值得拔剑守护的人。" },
    { "category": "元素战技·其一", "text": "列队。" },
    { "category": "元素战技·其二", "text": "敬礼。" },
    { "category": "元素战技·其三", "text": "举剑。" },
    { "category": "元素战技·其四", "text": "让一让~" },
    { "category": "元素战技·其五", "text": "没结束哦。" },
    { "category": "元素战技·其六", "text": "向您致意。" },
    { "category": "元素爆发·其一", "text": "陪你们玩玩吧！" },
    { "category": "元素爆发·其二", "text": "瞄准——逃不掉咯！" },
    { "category": "元素爆发·其三", "text": "献予女皇陛下——" },
    { "category": "打开宝箱·其一", "text": "喔喔，新藏品入库！" },
    { "category": "打开宝箱·其二", "text": "你一件，我一件，陛下一件，我一件，分完了！达妮卡没有，哈哈。" },
    { "category": "打开宝箱·其三", "text": "这呢这呢，看这里！" },
    { "category": "生命值低·其一", "text": "司令官当然要留守在战场上。" },
    { "category": "生命值低·其二", "text": "放心，我能躲开哦。" },
    { "category": "生命值低·其三", "text": "咳...暂时的劣势..." },
    { "category": "同伴生命值低·其一", "text": "撤退，由冬契军接管。" },
    { "category": "同伴生命值低·其二", "text": "别逞强，亲爱的朋友。" },
    { "category": "倒下·其一", "text": "飞不起来了..." },
    { "category": "倒下·其二", "text": "永远效忠...女皇陛下..." },
    { "category": "倒下·其三", "text": "我不痛...只是，不甘心..." },
    { "category": "普通受击·其一", "text": "什么动静？" },
    { "category": "普通受击·其二", "text": "哈？" },
    { "category": "重受击·其一", "text": "你竟敢！" },
    { "category": "重受击·其二", "text": "真无礼！" },
    { "category": "加入队伍·其一", "text": "巡视时间到~" },
    { "category": "加入队伍·其二", "text": "我看看——有什么好玩的呢？" },
    { "category": "加入队伍·其三", "text": "那就等你的号令咯？" },
    { "category": "闲聊·效劳", "text": "冬契军只听命于女皇陛下，当然不能随随便便就为你效劳了。但，风仙薇斯纳可以哦，亲爱的朋友。" },
    { "category": "闲聊·快乐", "text": "这身仪装好看吧？陛下亲赐的，多看几眼也无妨。" },
    { "category": "闲聊·高效", "text": "案牍工作？早做完啦，花不了多久。接下来都算巡视时间，走~" },
    { "category": "下雨的时候", "text": "妖精当然也会着凉，淋湿了要赶快扇干，我指翅膀。" },
    { "category": "下雪的时候", "text": "白茫茫的雪地里，任何一点伪装的瑕疵都会变得极为致命。走路当心点哦，亲爱的朋友。" },
    { "category": "阳光很好", "text": "我知道我知道，阳光下我的翅膀最是闪亮。" },
    { "category": "起风的时候", "text": "不错，是风仙喜欢的天气。" },
    { "category": "在沙漠的时候", "text": "随口一问...我们什么时候回至冬？" },
    { "category": "早上好", "text": "新的一天！向你问候，至冬堡！" },
    { "category": "中午好", "text": "走吧，去老庭院餐厅！当然依旧是我请客咯。" },
    { "category": "晚安", "text": "嘘嘘...这就要睡了吗？要出去散步吗？有极光欸！" }
  ]
}
